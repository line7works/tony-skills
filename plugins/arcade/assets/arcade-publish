#!/usr/bin/env node
/**
 * arcade-publish — post an HTML page to the Line 7 Arcade from the terminal.
 *
 * Usage:
 *   arcade-publish list
 *   arcade-publish publish <file.html> --name "My Game" [--slug my-game] [--featured]
 *   arcade-publish update <slug> <file.html> [--name "New Name"] [--featured|--no-featured]
 *   arcade-publish delete <slug> [--yes]
 *
 * Config: ~/.config/line7/arcade.json  →  { "password": "...", "base": "https://line7.works" }
 *
 * list, publish, and delete run on the per-resource /api/admin/seeds endpoints:
 * each one touches a single seed, so a concurrent admin edit can no longer be
 * clobbered by a whole-document write. delete never fires without printing its
 * target first and getting a yes — interactively, or via --yes.
 *
 * update still uses the legacy whole-document PUT /api/admin — with all its
 * hazards (last-write-wins, whole-document GET, can resurrect a page deleted
 * from an open admin tab). Since 2026-08-14 the server's per-resource PATCH
 * DOES accept `url`, so this is no longer forced; rewiring update onto it is
 * Slice B R3/R5 of docs/arcade-skill-build-plan.md, not yet built.
 *
 * `base` must be https, except for a local dev server on localhost/127.0.0.1.
 */

const fs = require("fs");
const path = require("path");
const os = require("os");
const readline = require("readline");

const CONFIG_PATH = path.join(os.homedir(), ".config", "line7", "arcade.json");
const RESERVED_SLUGS = new Set(["admin", "api", "new", "edit", "index"]);

// The one http:// exception: a dev server on this machine, where the password
// never leaves the loopback interface. Anchored and port-optional so it cannot
// be widened by a lookalike host — "http://localhost.evil.com" does not match.
const LOCAL_BASE = /^http:\/\/(localhost|127\.0\.0\.1)(:\d+)?$/;

function slugify(input) {
  return input
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 60);
}

function fail(msg) {
  console.error("arcade-publish: " + msg);
  process.exit(1);
}

function loadConfig() {
  let raw;
  try {
    raw = fs.readFileSync(CONFIG_PATH, "utf8");
  } catch {
    fail(
      `no config at ${CONFIG_PATH}\n` +
        `Create it with:\n` +
        `  { "password": "<admin password>", "base": "https://line7.works" }`
    );
  }
  const cfg = JSON.parse(raw);
  if (!cfg.password) fail(`config ${CONFIG_PATH} has no "password"`);
  cfg.base = (cfg.base || "https://www.line7.works").replace(/\/+$/, "");
  if (!cfg.base.startsWith("https://") && !LOCAL_BASE.test(cfg.base)) {
    fail(
      `"base" must start with https:// — the admin password travels on every request\n` +
        `(the only exception is a local dev server: http://localhost[:port] or http://127.0.0.1[:port])`
    );
  }
  return cfg;
}

// The page a slug resolves to. Against a local dev server the production URL
// would name a different page entirely, which matters most in delete's
// confirmation gate: the preview has to name the page actually about to go.
function pageUrl(cfg, slug) {
  return LOCAL_BASE.test(cfg.base)
    ? `${cfg.base}/arcade/${slug}`
    : `https://arcade.line7.works/arcade/${slug}`;
}

// All requests refuse redirects: a cross-origin hop silently drops the session
// cookie (and a redirected login re-sends the password body elsewhere).
async function send(url, opts) {
  let res;
  try {
    res = await fetch(url, { ...opts, redirect: "manual" });
  } catch (e) {
    fail(`request to ${url} failed: ${e.message}`);
  }
  if (res.status >= 300 && res.status < 400) {
    const loc = res.headers.get("location") || "(no location)";
    fail(
      `${url} redirects to ${loc} — set "base" in ${CONFIG_PATH} to the canonical host instead`
    );
  }
  return res;
}

async function login(cfg) {
  const res = await send(cfg.base + "/api/admin/session", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ password: cfg.password }),
  });
  if (!res.ok) fail(`login failed (${res.status}) — check the password in ${CONFIG_PATH}`);
  const setCookie = res.headers.get("set-cookie") || "";
  const match = setCookie.match(/line7_admin_session=[^;]+/);
  if (!match) fail("login succeeded but no session cookie came back");
  return match[0];
}

// The gallery in menu order (featured first, then `order`), straight from the
// server — no client-side re-sorting, so what prints is what the site shows.
async function listSeeds(cfg, cookie) {
  const res = await send(cfg.base + "/api/admin/seeds", { headers: { Cookie: cookie } });
  if (!res.ok) fail(`reading the gallery failed (${res.status})`);
  const data = await res.json().catch(() => null);
  if (data === null || typeof data !== "object" || !Array.isArray(data.seeds)) {
    fail("the gallery response had no seed list — refusing to continue");
  }
  return data.seeds;
}

// Whole-document read, kept for `update` alone: it is the last caller of the
// legacy PUT /api/admin. The server's PATCH accepts `url` as of 2026-08-14, so
// this path is legacy by inertia, not necessity — rewiring is Slice B R3/R5.
// Everything else reads through listSeeds() above.
async function getSeeds(cfg, cookie) {
  const res = await send(cfg.base + "/api/admin", { headers: { Cookie: cookie } });
  if (!res.ok) fail(`reading site data failed (${res.status})`);
  const data = await res.json().catch(() => null);
  // Guard the destructive PUT below: only trust an empty list if the response
  // is recognizably the site document, not some other 200 body.
  if (data === null || typeof data !== "object") {
    fail("site data response was not JSON — refusing to touch the seed list");
  }
  if (!Array.isArray(data.seeds)) {
    if (data.seeds !== undefined || !("adminPassword" in data || "passcode" in data || "projects" in data)) {
      fail("site data response has no usable seed list — refusing to touch the seed list");
    }
  }
  return { data, seeds: Array.isArray(data.seeds) ? data.seeds : [] };
}

async function cmdList() {
  const cfg = loadConfig();
  const cookie = await login(cfg);
  const seeds = await listSeeds(cfg, cookie);
  if (seeds.length === 0) {
    console.log("The arcade is empty.");
    return;
  }
  // Printed in the server's menu order, not re-sorted here: the server owns the
  // sort (featured first, then `order`), and a second opinion would only drift.
  for (const s of seeds) {
    const flag = s.featured ? " ★" : "";
    const order = typeof s.order === "number" ? `order ${s.order}` : "no order";
    const when = typeof s.uploadedAt === "string" ? s.uploadedAt.slice(0, 10) : "date unknown";
    console.log(`${s.slug}${flag}  —  ${s.name}  (${order}, ${when})`);
    console.log(`  ${pageUrl(cfg, s.slug)}`);
  }
}

async function cmdPublish(args) {
  const file = args._[0];
  if (!file) fail("usage: arcade-publish publish <file.html> --name \"Name\" [--slug x] [--featured]");
  if (!file.endsWith(".html")) fail("the file must end in .html");
  let html;
  try {
    html = fs.readFileSync(file);
  } catch {
    fail(`cannot read ${file}`);
  }

  const name = args.name || path.basename(file, ".html");
  const slug = slugify(args.slug || name);
  if (!slug) fail(`"${name}" produces an empty slug — pass --slug`);
  if (RESERVED_SLUGS.has(slug)) fail(`"${slug}" is a reserved slug`);

  const cfg = loadConfig();
  const cookie = await login(cfg);

  // No client-side duplicate pre-check: it read a list that was already stale
  // by the time the write went out. The server's 409 is authoritative.
  const form = new FormData();
  form.append("file", new Blob([html], { type: "text/html" }), path.basename(file));
  const upRes = await send(cfg.base + "/api/admin/upload", {
    method: "POST",
    headers: { Cookie: cookie },
    body: form,
  });
  const upBody = await upRes.json().catch(() => ({}));
  if (!upRes.ok) fail(`upload failed (${upRes.status}): ${upBody.error || "unknown error"}`);
  if (!upBody.id || !upBody.url) {
    fail("upload returned no id/url — refusing to register a broken seed");
  }

  // One seed, one call. The server assigns `order` and is the only judge of
  // whether the slug is free.
  const createRes = await send(cfg.base + "/api/admin/seeds", {
    method: "POST",
    headers: { "Content-Type": "application/json", Cookie: cookie },
    body: JSON.stringify({
      name: name.trim(),
      url: upBody.url,
      slug,
      featured: Boolean(args.featured),
    }),
  });
  if (!createRes.ok) {
    const errBody = await createRes.json().catch(() => ({}));
    // The upload only exists to back a seed that now will not exist. Clean it
    // up, but report honestly if the cleanup itself did not land.
    const cleaned = await deleteUpload(cfg, cookie, upBody.url);
    const orphan =
      cleaned && cleaned.ok
        ? "the uploaded file was removed"
        : `the uploaded file is orphaned (${upBody.url})`;
    if (createRes.status === 409) {
      fail(`"${slug}" is already taken — pick another slug, or use update to replace that page (${orphan})`);
    }
    if (createRes.status === 400) {
      fail(`the server rejected the seed: ${errBody.error || "missing name/url or unusable slug"} (${orphan})`);
    }
    fail(`upload stored but registering the seed failed (${createRes.status}) — ${orphan}; re-run to retry`);
  }
  const created = await createRes.json().catch(() => ({}));
  if (!created.seed || !created.seed.slug) {
    fail("the seed was registered but the server returned no seed object — run list to check what landed");
  }

  console.log(`Live: ${pageUrl(cfg, created.seed.slug)}`);
  console.log(`Gallery: https://line7.works/arcade`);
}

// Cleanup/rollback path: must never kill the process, or the caller's real
// message (success or the actual error) is lost behind a generic
// "request failed". Returns the response, or null on network error/redirect.
async function deleteUpload(cfg, cookie, url) {
  try {
    const res = await fetch(cfg.base + "/api/admin/upload", {
      method: "DELETE",
      headers: { "Content-Type": "application/json", Cookie: cookie },
      body: JSON.stringify({ url }),
      redirect: "manual",
    });
    return res.status >= 300 && res.status < 400 ? null : res;
  } catch {
    return null;
  }
}

async function cmdUpdate(args) {
  const [slugArg, file] = args._;
  if (!slugArg || !file) {
    fail('usage: arcade-publish update <slug> <file.html> [--name "Name"] [--featured|--no-featured]');
  }
  if (!file.endsWith(".html")) fail("the file must end in .html");
  let html;
  try {
    html = fs.readFileSync(file);
  } catch {
    fail(`cannot read ${file}`);
  }
  const slug = slugify(slugArg);

  const cfg = loadConfig();
  const cookie = await login(cfg);
  const { seeds } = await getSeeds(cfg, cookie);
  const existing = seeds.find((s) => s.slug === slug);
  if (!existing) {
    fail(`no seed with slug "${slug}" — use publish to create it, or list to see what exists`);
  }

  const form = new FormData();
  form.append("file", new Blob([html], { type: "text/html" }), path.basename(file));
  const upRes = await send(cfg.base + "/api/admin/upload", {
    method: "POST",
    headers: { Cookie: cookie },
    body: form,
  });
  const upBody = await upRes.json().catch(() => ({}));
  if (!upRes.ok) fail(`upload failed (${upRes.status}): ${upBody.error || "unknown error"}`);
  if (!upBody.id || !upBody.url) {
    fail("upload returned no id/url — refusing to register a broken seed");
  }

  // Re-read just before writing; the PUT replaces the whole array.
  const fresh = await getSeeds(cfg, cookie);
  const current = fresh.seeds.find((s) => s.slug === slug);
  if (!current) {
    await deleteUpload(cfg, cookie, upBody.url);
    fail(`"${slug}" was deleted while uploading — nothing was changed`);
  }
  const oldUrl = current.url;
  const updated = {
    ...current,
    id: upBody.id,
    url: upBody.url,
    uploadedAt: new Date().toISOString(),
  };
  if (args.name) updated.name = args.name.trim();
  if (args.featured !== undefined) updated.featured = args.featured;

  const putRes = await send(cfg.base + "/api/admin", {
    method: "PUT",
    headers: { "Content-Type": "application/json", Cookie: cookie },
    body: JSON.stringify({ seeds: fresh.seeds.map((s) => (s.slug === slug ? updated : s)) }),
  });
  if (!putRes.ok) {
    await deleteUpload(cfg, cookie, upBody.url);
    fail(`registering the update failed (${putRes.status}) — the old page is untouched`);
  }

  // Old file is only garbage once the seed points at the new one; a failure
  // here just leaves an orphaned upload, which is harmless.
  if (oldUrl && oldUrl !== upBody.url) {
    const delRes = await deleteUpload(cfg, cookie, oldUrl);
    if (!delRes || !delRes.ok) {
      console.error(`note: old upload was not deleted (${oldUrl}) — orphaned but harmless`);
    }
  }

  console.log(`Updated: https://arcade.line7.works/arcade/${slug}`);
}

// The confirmation gate. Prompts on stderr so a piped stdout stays clean, and
// refuses outright rather than defaulting either way when there is no terminal
// to answer on — an unattended `delete` must never proceed on silence.
function confirmDelete() {
  return new Promise((resolve) => {
    if (!process.stdin.isTTY) {
      fail(
        "delete needs confirmation and stdin is not a terminal — " +
          "re-run it interactively, or pass --yes if you already know what goes"
      );
    }
    const rl = readline.createInterface({ input: process.stdin, output: process.stderr });
    rl.question("Delete it? [y/N] ", (answer) => {
      rl.close();
      resolve(/^y(es)?$/i.test(answer.trim()));
    });
  });
}

async function cmdDelete(args) {
  const slugArg = args._[0];
  if (!slugArg) fail("usage: arcade-publish delete <slug> [--yes]");
  const slug = slugify(slugArg);

  const cfg = loadConfig();
  const cookie = await login(cfg);
  const seeds = await listSeeds(cfg, cookie);
  const target = seeds.find((s) => s.slug === slug);
  if (!target) {
    fail(`no seed with slug "${slug}" — run list to see what exists`);
  }

  // Say what is about to go before anything destructive happens. Deleting a
  // page is not undoable, and this used to fire on a fat-fingered slug with no
  // preview at all — the seed's name only printed after it was already gone.
  console.error("About to delete:");
  console.error(`  slug: ${target.slug}`);
  console.error(`  name: ${target.name}`);
  console.error(`  url:  ${pageUrl(cfg, target.slug)}`);
  if (!args.yes && !(await confirmDelete())) {
    console.error(`Aborted — "${target.slug}" is still there.`);
    process.exit(1);
  }

  // Unregister first, delete the file second: a failure between the two leaves
  // an orphaned upload (harmless) rather than a live page pointing at nothing.
  const delSeedRes = await send(
    `${cfg.base}/api/admin/seeds/${encodeURIComponent(target.id)}`,
    { method: "DELETE", headers: { Cookie: cookie } }
  );
  if (!delSeedRes.ok) {
    if (delSeedRes.status === 404) fail(`"${slug}" is already gone — nothing to do`);
    fail(`removing the seed failed (${delSeedRes.status}) — nothing was changed`);
  }

  if (target.url) {
    const delRes = await deleteUpload(cfg, cookie, target.url);
    if (!delRes || !delRes.ok) {
      console.error(`note: uploaded file was not deleted (${target.url}) — orphaned but harmless`);
    }
  }

  console.log(`Deleted "${slug}" (${target.name})`);
}

// Per-command grammar. Anything not listed is a hard error: for a tool with a
// destructive command, silently ignoring a typo'd flag or a stray positional
// is how the wrong page gets touched.
const COMMANDS = {
  list: { flags: {}, positionals: 0 },
  publish: { flags: { "--name": "value", "--slug": "value", "--featured": "bool", "--no-featured": "bool" }, positionals: 1 },
  update: { flags: { "--name": "value", "--featured": "bool", "--no-featured": "bool" }, positionals: 2 },
  delete: { flags: { "--yes": "bool" }, positionals: 1 },
};

function parseArgs(argv, cmd) {
  const grammar = COMMANDS[cmd];
  const args = { _: [] };
  if (!grammar) return args;
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      const kind = grammar.flags[a];
      if (!kind) {
        if (cmd === "update" && a === "--slug") {
          fail("slugs can't be renamed — update keeps the slug; to move a page, delete the old slug and publish the new one");
        }
        fail(`unknown flag ${a} for "${cmd}"`);
      }
      if (kind === "value") {
        const v = argv[++i];
        if (v === undefined || v.startsWith("--")) fail(`${a} needs a value`);
        if (a === "--name") args.name = v;
        else args.slug = v;
      } else if (a === "--yes") {
        args.yes = true;
      } else {
        args.featured = a === "--featured";
      }
    } else {
      args._.push(a);
    }
  }
  if (args._.length > grammar.positionals) {
    fail(`unexpected argument "${args._[grammar.positionals]}"`);
  }
  return args;
}

(async () => {
  const [cmd, ...rest] = process.argv.slice(2);
  const args = parseArgs(rest, cmd);
  if (cmd === "list") await cmdList();
  else if (cmd === "publish") await cmdPublish(args);
  else if (cmd === "update") await cmdUpdate(args);
  else if (cmd === "delete") await cmdDelete(args);
  else {
    console.log(
      "usage: arcade-publish list\n" +
        '       arcade-publish publish <file.html> --name "Name" [--slug x] [--featured]\n' +
        '       arcade-publish update <slug> <file.html> [--name "Name"] [--featured|--no-featured]\n' +
        "       arcade-publish delete <slug> [--yes]"
    );
    process.exit(cmd ? 1 : 0);
  }
})().catch((e) => fail(e.message));
